{
  "name": "arcus-attribution",
  "account_id": "5695cae2becf35e049eb5df3e2849ae2",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "ratelimits": [
    {
      "name": "LOGIN_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "kv_namespaces": [
    {
      "binding": "HOLDINGS_ARCHIVE",
      "id": "98da8aed88f9416d84a9497daed06dc5"
    }
  ]
}
